apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ k8s_scrape_serviceaccount }}
  namespace: {{ k8s_scrape_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: {{ k8s_scrape_serviceaccount }}-role
rules:
  - apiGroups: [""]
    resources:
      - nodes
      - nodes/proxy
      - nodes/metrics
      - nodes/stats
    verbs: ["get", "list", "watch"]
  - nonResourceURLs:
      - /metrics
      - /metrics/cadvisor
      - /metrics/resource
    verbs: ["get"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ k8s_scrape_serviceaccount }}-binding
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: {{ k8s_scrape_serviceaccount }}-role
subjects:
  - kind: ServiceAccount
    name: {{ k8s_scrape_serviceaccount }}
    namespace: {{ k8s_scrape_namespace }}
